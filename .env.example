# ==============================================================================
# CONFIGURAÇÃO DAS APIS DE PAGAMENTO SICREDI (BANCO 748)
# Copie este arquivo para .env.local e preencha com as credenciais do
# Portal do Desenvolvedor Sicredi (https://developer.sicredi.com.br)
# ==============================================================================

# Ambiente: 'sandbox' (homologação/simulação) ou 'production' (produção real)
SICREDI_ENV=sandbox
NEXT_PUBLIC_SICREDI_ENV=sandbox

# Dados do Beneficiário / Estabelecimento na Cooperativa Sicredi
SICREDI_BENEFICIARIO_NOME="ESPACO CATOLICO SANTO ANTONIO LTDA"
SICREDI_BENEFICIARIO_CNPJ="45.812.930/0001-74"

# ------------------------------------------------------------------------------
# 1. API PIX SICREDI (Padrão BACEN — Cobrança Imediata / Webhook)
# Homologação: https://api-pix-h.sicredi.com.br
# Produção:    https://api-pix.sicredi.com.br
# ------------------------------------------------------------------------------
SICREDI_PIX_BASE_URL=https://api-pix-h.sicredi.com.br
SICREDI_PIX_CLIENT_ID=
SICREDI_PIX_CLIENT_SECRET=
SICREDI_PIX_CHAVE=financeiro@espacocatolicosantoantonio.com.br
NEXT_PUBLIC_SICREDI_PIX_CHAVE=financeiro@espacocatolicosantoantonio.com.br

# ------------------------------------------------------------------------------
# 2. API DE COBRANÇA / BOLETO HÍBRIDO SICREDI (Banco 748 + QR Code PIX)
# Sandbox:  https://api-parceiro.sicredi.com.br/sb
# Produção: https://api-parceiro.sicredi.com.br
# ------------------------------------------------------------------------------
SICREDI_COBRANCA_BASE_URL=https://api-parceiro.sicredi.com.br/sb
SICREDI_COBRANCA_API_KEY=
SICREDI_COOPERATIVA=0101
SICREDI_POSTO=02
SICREDI_CODIGO_BENEFICIARIO=12345
SICREDI_CODIGO_ACESSO=

# ------------------------------------------------------------------------------
# 3. API E-COMMERCE CARTÃO DE CRÉDITO E DÉBITO (Sicredi Pagamentos / Adquirência)
# ------------------------------------------------------------------------------
SICREDI_ECOMMERCE_BASE_URL=https://api-ecommerce.sicredi.com.br/v1
SICREDI_ECOMMERCE_MERCHANT_ID=
SICREDI_ECOMMERCE_MERCHANT_KEY=
