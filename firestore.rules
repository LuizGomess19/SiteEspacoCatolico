rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sincronizacao isolada por chave criptografica (bloqueia listagem publica de colecao)
    match /espaco_catolico_sync/{docId} {
      allow get: if docId.size() >= 8 && docId.size() <= 128;
      allow list: if false;
      allow create, update: if docId.size() >= 8
        && docId.size() <= 128
        && request.resource.data.keys().hasOnly(['payload', 'updatedAt'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 60000
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
